{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
  "esModuleInterop": true,
  "ignoreDeprecations": "6.0",
  "target": "es2023",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "rootDir": "./src",
  "outDir": "./dist",
  "strict": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true
},
"include": ["src/**/*.ts"],
"exclude": ["node_modules"]
}
