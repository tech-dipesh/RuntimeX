generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}

model events {
  id          String   @id @default(uuid(7))
  project_id  String
  session_id  String
  type        Type     @default(api_call)
  payload     Json
  client_ts   DateTime
  received_at DateTime @default(now())
}

model project {
  id         String      @id @default("gen_random_uuid()")
  name       String
  created_at DateTime    @default(now())
  updated_at DateTime?
  raw_events raw_event[]
  sessions   session[]
}

model session {
  id         String      @id @default(uuid(7))
  project_id String
  started_at DateTime    @default(now())
  ended_at   DateTime?
  raw_events raw_event[]
  project    project     @relation(fields: [project_id], references: [id])
}

model raw_event {
  id          String   @id @default(uuid(7))
  project_id  String
  session_id  String
  type        String
  payload     Json
  client_ts   DateTime
  received_at DateTime @default(now())
  project     project  @relation(fields: [project_id], references: [id])
  session     session  @relation(fields: [session_id], references: [id])
}

enum Type {
  api_call
  render
}
